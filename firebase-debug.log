[debug] [2026-10-15T02:56:16.906Z] >>> [apiv2][query] PUT http://127.0.0.1:8085/emulator/v1/projects/demo-cinestream-test:securityRules [none]
[debug] [2026-10-15T02:56:16.907Z] >>> [apiv2][body] PUT http://127.0.0.1:8085/emulator/v1/projects/demo-cinestream-test:securityRules {"ignore_errors":true,"rules":{"files":[{"name":"security.rules","content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    // Helper functions\n    function isAuthenticated() {\n      return request.auth != null;\n    }\n\n    function isOwner(userId) {\n      return isAuthenticated() && request.auth.uid == userId;\n    }\n\n    function isAdmin() {\n      return isAuthenticated() && \n        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&\n        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true;\n    }\n\n    // Admins Collection: Access based on /admins/{uid} enabled == true\n    match /admins/{adminId} {\n      allow read: if isAdmin() || (isAuthenticated() && request.auth.uid == adminId);\n      allow write: if isAdmin();\n    }\n\n    // App Configuration: Read for authenticated users, write only for admins\n    match /config/app {\n      allow read: if isAuthenticated();\n      allow write: if isAdmin();\n    }\n\n    // Search Order Configuration: Public read for global extension order, write only for admins\n    match /config/search_order {\n      allow read: if true;\n      allow write: if isAdmin();\n    }\n\n    // Features Configuration: Read for authenticated users, write only for admins\n    match /config/features {\n      allow read: if isAuthenticated();\n      allow write: if isAdmin();\n    }\n\n    // Economy Configuration: Read for authenticated users, write only for admins\n    match /config/economy {\n      allow read: if isAuthenticated();\n      allow write: if isAdmin();\n    }\n\n    // Prohibit any access to deprecated config paths\n    match /config/{document=**} {\n      allow read, write: if false;\n    }\n\n    // Users Collection\n    match /users/{userId} {\n      // Owner or Admin can read full private user document (addresses A05)\n      allow read: if isOwner(userId) || isAdmin();\n      \n      // User can create their own document with restricted initial fields\n      allow create: if isOwner(userId) &&\n        request.resource.data.uid == userId &&\n        (!('role' in request.resource.data) || request.resource.data.role == 'user') &&\n        (!('isPremium' in request.resource.data) || request.resource.data.isPremium == false) &&\n        (!('subscriptionTier' in request.resource.data) || request.resource.data.subscriptionTier == 'free' || request.resource.data.subscriptionTier == 'FREE') &&\n        (!('plan' in request.resource.data) || request.resource.data.plan == 'free') &&\n        (!('planId' in request.resource.data) || request.resource.data.planId == 'free') &&\n        (!('durationDays' in request.resource.data) || request.resource.data.durationDays == 0) &&\n        (!('subscriptionStatus' in request.resource.data) || request.resource.data.subscriptionStatus == 'none' || request.resource.data.subscriptionStatus == 'NONE' || request.resource.data.subscriptionStatus == 'inactive' || request.resource.data.subscriptionStatus == 'INACTIVE' || request.resource.data.subscriptionStatus == '') &&\n        (!('subscriptionSource' in request.resource.data) || request.resource.data.subscriptionSource == 'LEGACY') &&\n        (!('pointsBalance' in request.resource.data) || request.resource.data.pointsBalance == 0) &&\n        (!('totalPointsEarned' in request.resource.data) || request.resource.data.totalPointsEarned == 0) &&\n        (!('totalPointsSpent' in request.resource.data) || request.resource.data.totalPointsSpent == 0) &&\n        (!('isBanned' in request.resource.data) || request.resource.data.isBanned == false) &&\n        (!('isActive' in request.resource.data) || request.resource.data.isActive == true) &&\n        (!('banReason' in request.resource.data) || request.resource.data.banReason == '') &&\n        (!('canWatch' in request.resource.data) || request.resource.data.canWatch == true) &&\n        (!('canDownload' in request.resource.data) || request.resource.data.canDownload == true) &&\n        (!('canChat' in request.resource.data) || request.resource.data.canChat == true) &&\n        (!('canStory' in request.resource.data) || request.resource.data.canStory == true) &&\n        (!('canP2P' in request.resource.data) || request.resource.data.canP2P == true) &&\n        (!('canComment' in request.resource.data) || request.resource.data.canComment == true) &&\n        (!('canUpload' in request.resource.data) || request.resource.data.canUpload == true) &&\n        (!('canRequest' in request.resource.data) || request.resource.data.canRequest == true) &&\n        !request.resource.data.keys().hasAny([\n          'deviceLimit', 'maxDevices', 'allowedQuality', 'downloadLimit',\n          'subscriptionExpiresAt', 'subscriptionStartedAt', 'subscriptionReferenceId',\n          'proExpiresAt', 'proPlan',\n          'banExpiresAt',\n          'watchBan', 'downloadBan', 'chatBan', 'storyBan', 'p2pBan',\n          'offlineDaysOverride', 'forcedAdsOverride',\n          'admin', 'isAdmin'\n        ]);\n\n      // Hardened User updates: Owner can only update non-sensitive profile fields (displayName, username, photoUrl, bio, etc.).\n      // Strict denial is enforced against administrative privileges, bans, subscriptions, and economy/points fields (addresses A09 & B01).\n      allow update: if isAdmin() || (\n        isOwner(userId) &&\n        !request.resource.data.diff(resource.data).affectedKeys()\n          .hasAny([\n            // Identity & System immutables\n            'uid', 'email', 'createdAt',\n            // Admin & Roles\n            'role', 'admin', 'isAdmin',\n            // Bans & Limits\n            'isActive', 'isBanned', 'banReason', 'banExpiresAt',\n            'canWatch', 'canDownload', 'canChat', 'canStory', 'canP2P',\n            'watchBan', 'downloadBan', 'chatBan', 'storyBan', 'p2pBan',\n            'deviceLimit', 'maxDevices', 'allowedQuality', 'downloadLimit',\n            'offlineDaysOverride', 'forcedAdsOverride',\n            // Subscription fields (addresses A09)\n            'isPremium', 'subscriptionTier', 'subscriptionStatus',\n            'subscriptionExpiresAt', 'subscriptionStartedAt', 'subscriptionSource',\n            'subscriptionReferenceId', 'proExpiresAt', 'proPlan', 'plan', 'planId',\n            'durationDays', 'vip',\n            // Economy & Points fields (addresses B01)\n            'pointsBalance', 'totalPointsEarned', 'totalPointsSpent', 'points', 'balance'\n          ])\n      );\n\n      // User deletion: Owner or admin can delete user document\n      allow delete: if isOwner(userId) || isAdmin();\n\n      // Dedicated Public Profile Subcollection for future safe cross-user reads\n      match /public/{docId} {\n        allow read: if isAuthenticated();\n        allow write: if isOwner(userId) || isAdmin();\n      }\n\n      // User subcollections (Library, History, Watched Episodes)\n      match /library/{itemId} {\n        allow read, write: if isOwner(userId) || isAdmin();\n      }\n\n      match /history/{itemId} {\n        allow read, write: if isOwner(userId) || isAdmin();\n      }\n\n      match /watched_episodes/{episodeId} {\n        allow read, write: if isOwner(userId) || isAdmin();\n      }\n\n      // User Point Transactions Ledger: Strictly Admin / Trusted Backend managed (addresses B02)\n      match /point_transactions/{txId} {\n        allow read: if isOwner(userId) || isAdmin();\n        allow write: if isAdmin();\n      }\n\n      // User Task Claims: Separate create/update/delete explicitly (addresses Section 3.G & B04)\n      match /task_claims/{claimId} {\n        allow read: if isOwner(userId) || isAdmin();\n        allow create: if isAdmin() || (isOwner(userId) && request.resource.data.userId == userId);\n        allow update: if isAdmin();\n        allow delete: if isAdmin();\n      }\n\n      // User Settings (Notification Preferences)\n      match /settings/notifications {\n        allow read: if isOwner(userId) || isAdmin();\n        allow write: if (isOwner(userId) || isAdmin()) &&\n          !request.resource.data.keys().hasAny(['role', 'admin', 'isAdmin', 'isPremium', 'subscriptionTier', 'isBanned', 'banReason']);\n      }\n\n      match /settings/{document=**} {\n        allow read, write: if isOwner(userId) || isAdmin();\n      }\n\n      // User FCM Tokens: Device-level tokens; strictly private to owner and admin\n      match /fcmTokens/{installationId} {\n        allow read: if isOwner(userId) || isAdmin();\n\n        allow create: if (isOwner(userId) || isAdmin()) &&\n          request.resource.data.installationId == installationId &&\n          request.resource.data.token is string &&\n          request.resource.data.token.size() > 0 &&\n          request.resource.data.platform == 'android' &&\n          request.resource.data.deviceModel is string &&\n          request.resource.data.osVersion is string &&\n          request.resource.data.appVersion is string &&\n          request.resource.data.isActive == true &&\n          request.resource.data.createdAt == request.time &&\n          request.resource.data.updatedAt == request.time &&\n          request.resource.data.lastSeenAt == request.time &&\n          !request.resource.data.keys().hasAny(['role', 'admin', 'isAdmin', 'isPremium', 'subscriptionTier', 'uid', 'userId']);\n\n        allow update: if isAdmin() || (\n          isOwner(userId) &&\n          request.resource.data.installationId == resource.data.installationId &&\n          request.resource.data.installationId == installationId &&\n          request.resource.data.platform == resource.data.platform &&\n          request.resource.data.platform == 'android' &&\n          (request.resource.data.createdAt == resource.data.createdAt || request.resource.data.createdAt == request.time) &&\n          (request.resource.data.updatedAt == resource.data.updatedAt || request.resource.data.updatedAt == request.time) &&\n          (request.resource.data.lastSeenAt == resource.data.lastSeenAt || request.resource.data.lastSeenAt == request.time) &&\n          request.resource.data.token is string &&\n          request.resource.data.token.size() > 0 &&\n          request.resource.data.deviceModel is string &&\n          request.resource.data.osVersion is string &&\n          request.resource.data.appVersion is string &&\n          request.resource.data.isActive is bool &&\n          (!('deactivationReason' in request.resource.data) || request.resource.data.deactivationReason is string) &&\n          (!('deactivatedAt' in request.resource.data) || request.resource.data.deactivatedAt == request.time || request.resource.data.deactivatedAt == resource.data.deactivatedAt) &&\n          !request.resource.data.keys().hasAny(['role', 'admin', 'isAdmin', 'isPremium', 'subscriptionTier', 'uid', 'userId'])\n        );\n\n        allow delete: if isOwner(userId) || isAdmin();\n      }\n    }\n\n    // Managed Extensions Catalog: Public read for global extension control, write only for admins\n    match /managed_extensions/{extensionId} {\n      allow read: if true;\n      allow write: if isAdmin();\n    }\n\n    // Legacy Extensions Catalog (Retained for backward compatibility): Public read, write only for admins\n    match /extensions/{extensionId} {\n      allow read: if true;\n      allow write: if isAdmin();\n    }\n\n    // Notifications: Read for authenticated users, write only for admins\n    match /notifications/{notificationId} {\n      allow read: if isAuthenticated();\n      allow write: if isAdmin();\n    }\n\n    // App Updates Catalog: Read for authenticated users, write only for admins\n    match /app_updates/{updateId} {\n      allow read: if isAuthenticated();\n      allow write: if isAdmin();\n    }\n\n    // Pro Subscription Upgrade Requests: User can submit PENDING request for themselves; Admin can review and resolve\n    match /pro_requests/{requestId} {\n      allow create: if isAuthenticated() &&\n        request.resource.data.userId == request.auth.uid &&\n        (request.resource.data.status == 'PENDING' || request.resource.data.status == 'pending') &&\n        !request.resource.data.keys().hasAny([\n          'approvedBy', 'approvedAt', 'grantedBy', 'grantSource',\n          'subscriptionTier', 'subscriptionStatus', 'subscriptionSource',\n          'subscriptionReferenceId', 'subscriptionStartedAt', 'subscriptionExpiresAt',\n          'isPremium', 'isPro', 'proPlan', 'proExpiresAt',\n          'admin', 'isAdmin', 'role'\n        ]);\n      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);\n      allow update, delete: if isAdmin();\n    }\n\n    // Reward Tasks Catalog: Authenticated users can read active tasks; Admin can manage\n    match /reward_tasks/{taskId} {\n      allow read: if isAuthenticated();\n      allow write: if isAdmin();\n    }\n\n    // Leaderboard & Weekly Rankings: Authenticated users can read; Admin/server manages\n    match /leaderboard/{docId} {\n      allow read: if isAuthenticated();\n      allow write: if isAdmin();\n    }\n\n    // Leaderboard History Archives: Authenticated users can read; Admin/server manages\n    match /leaderboard_history/{historyId} {\n      allow read: if isAuthenticated();\n      allow write: if isAdmin();\n    }\n\n    // Reports: Any authenticated user can submit; only admin can read all and resolve\n    match /reports/{reportId} {\n      allow create: if isAuthenticated() &&\n        request.resource.data.userId == request.auth.uid &&\n        request.resource.data.status == 'pending' &&\n        (!('resolvedBy' in request.resource.data) || request.resource.data.resolvedBy == null) &&\n        (!('resolvedAt' in request.resource.data) || request.resource.data.resolvedAt == null);\n      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId 